# ── Anthropic ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Servidor ───────────────────────────────────────────────
PORT=3000

# Fuso horário da clínica (GMT-3). Necessário p/ horário de atendimento e
# feriados ficarem corretos — o código também força America/Recife internamente.
TZ=America/Recife

# ── Redis (opcional — fallback em memória se não configurado)
REDIS_URL=redis://localhost:6379

# ── Modelo Claude ──────────────────────────────────────────
CLAUDE_MODEL=claude-sonnet-4-6
# Limite de tokens da resposta (opcional)
CLAUDE_MAX_TOKENS=1024
# Retries e timeout (ms) do cliente Anthropic (opcionais)
CLAUDE_MAX_RETRIES=2
CLAUDE_TIMEOUT_MS=60000

# ── Memória ────────────────────────────────────────────────
MAX_HISTORY_TURNS=20
# Janela (dias) de feriados injetada no prompt (opcional)
HOLIDAY_WINDOW_DAYS=21

# ── Logs ───────────────────────────────────────────────────
LOG_LEVEL=info

# ── Clínica ────────────────────────────────────────────────
CLINIC_PHONE=(83) 9999-9999

# ── Segurança ──────────────────────────────────────────────
# OBRIGATÓRIO: segredo compartilhado com o n8n (header: x-webhook-secret).
# Sem WEBHOOK_SECRET configurado, o webhook RECUSA todas as requisições (fail-closed).
WEBHOOK_SECRET=troque-este-segredo-agora

# Whitelist de números permitidos durante testes (separados por vírgula)
# Deixe vazio para permitir todos
ALLOWED_PHONES=

# ── Evolution API (envio proativo: lembretes, relatórios) ─────────────────
EVOLUTION_API_URL=http://cto-evolution:8080
EVOLUTION_API_KEY=cto-evolution-key-2024
# Telefone do médico (recebe relatórios e o resumo diário de formulários)
DOCTOR_PHONE=5581999179609
# Instância Evolution usada para mensagens proativas (relatórios, lembretes
# quando não sabemos a instância real do paciente)
REPORT_INSTANCE=cto-geral

# ── Agendamentos e lembretes de consulta ──────────────────────────────────
# Desative com "false" para desligar o scheduler de lembretes + resumo diário
APPOINTMENTS_ENABLED=true
# Hora (0-23, fuso da clínica) em que o resumo diário de formulários é enviado
FORMS_DIGEST_HOUR=19

# ── Formulário de pré-consulta ────────────────────────────────────────────
# Segredo do HMAC do token do formulário (troque em produção)
FORM_SECRET=troque-por-string-aleatoria-de-40-chars
# URL pública do servidor (usada para montar o link do formulário e dos PDFs)
FORM_BASE_URL=http://localhost:3030
# Webhook do n8n que recebe o formulário preenchido (Sheets/Drive/Calendar)
N8N_WEBHOOK_PRE_CONSULTA=http://n8n:5678/webhook/pre-consulta
